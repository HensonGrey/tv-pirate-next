# Copy to .env.local and fill in real values. .env.local is gitignored.

# Postgres. The migration runner and the app both read this one URL.
DATABASE_URL=postgresql://user:password@localhost:5432/tv-pirate-next

# Auth.js session/cookie signing. Generate with: npx auth secret
AUTH_SECRET=
# Base URL Auth.js builds callbacks from; also drives the cookie Secure flag.
AUTH_URL=http://localhost:3000

# TMDB. The v4 read access token also authenticates v3 calls, which keeps the
# key out of query strings entirely.
TMDB_READ_ACCESS_TOKEN=

# OpenSubtitles — free key at opensubtitles.com/consumers. Empty = captions off (503).
OPENSUBTITLES_API_KEY=

# Guest retention: the daily sweep deletes guests idle for this many days.
GUEST_RETENTION_DAYS=7
# Shared secret the cron trigger must present. Empty = session auth only.
CRON_SECRET=
